# Copia este archivo a `.env` y ajusta lo que necesites:
#   cp .env.example .env
#
# `.env` no se commitea (ver .gitignore).
#
# Los valores de este archivo son los defaults del código. En tu `.env` solo
# necesitás las OBLIGATORIAS (JWT_SECRET, DB_PASSWORD) y las que quieras
# cambiar; podés omitir el resto. Un valor vacío equivale a "no definido" y
# aplica el default.

# ── BASE DE DATOS ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
# OBLIGATORIA
DB_PASSWORD=
DB_NAME=dev_test_api
# disable | require | verify-full. En producción: require o verify-full.
# En Docker/Dokploy se fuerza `disable` por la red interna.
DB_SSL_MODE=disable

# ── SESIÓN / JWT ─────────────────────────────────────────────
# OBLIGATORIA: openssl rand -hex 32
JWT_SECRET=
# Recomendado 8–12 en producción.
JWT_EXPIRY_HOURS=24

# ── SETUP INICIAL ────────────────────────────────────────────
# Token del primer admin (POST /api/v1/auth/setup).
# Con la DB vacía es OBLIGATORIO (mín. 16 caracteres).
# Con usuarios ya creados puede quedar vacío.
SETUP_TOKEN=

# ── SERVIDOR ─────────────────────────────────────────────────
PORT=8080
# debug | release. En release se apaga Swagger y bajan los logs SQL.
GIN_MODE=release
# Orígenes permitidos por CORS, separados por coma.
# Agregá http://localhost:3000 si usas el web dev de este repo.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── HTTP HARDENING ───────────────────────────────────────────
# Tamaño máximo del body JSON (1 MiB). El import tiene su propio tope de 8 MiB.
MAX_BODY_BYTES=1048576
# IPs/CIDR del reverse proxy, separadas por coma. Vacío = no confiar en
# X-Forwarded-For. En Docker/Dokploy poné el CIDR del proxy.
TRUSTED_PROXIES=
# Ponlo en false solo si el borde sirve HTTP (dev/prod-local).
HSTS_ENABLED=true
# Vacío = on en debug y off en release.
SWAGGER_ENABLED=

# ── RATE LIMIT DE AUTH ───────────────────────────────────────
# Peticiones por minuto por IP para /auth/setup y /auth/login. 0 = deshabilitado.
AUTH_RATE_LIMIT_PER_MINUTE=10
# Ráfaga inicial permitida.
AUTH_RATE_LIMIT_BURST=5

# ── IA (opcional) ────────────────────────────────────────────
# Endpoint compatible con OpenAI. Sin URL y API key, la generación queda
# deshabilitada. Ejemplo OpenCode: https://opencode.ai/zen/go/v1/chat/completions
AI_API_URL=
# Nunca la commitees.
AI_API_KEY=
# Si usás el endpoint de OpenCode Go, poné un modelo que ese proveedor sirva
# (p. ej. deepseek-v4.1-flash).
AI_MODEL=gpt-4o-mini
# Segundos.
AI_REQUEST_TIMEOUT=120

# ── OPENCODE GO (opcional; reutiliza AI_API_KEY) ─────────────
OPENCODE_USAGE_URL=https://opencode.ai/zen/go/v1/usage
OPENCODE_USAGE_TIMEOUT=10

# ── PUSH EXPO (opcional) ─────────────────────────────────────
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=
