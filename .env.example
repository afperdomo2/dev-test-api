PORT=8080
GIN_MODE=release

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=dev_test_api
DB_SSL_MODE=disable

JWT_SECRET=
JWT_EXPIRY_HOURS=24

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# HTTP hardening
# Límite del body JSON en bytes (1 MiB). El import de preguntas tiene su propio tope de 8 MiB.
MAX_BODY_BYTES=1048576
# IPs/CIDR del reverse proxy (nginx, Caddy, Dokploy...), separadas por coma.
# Vacío = no confiar en X-Forwarded-For (recomendado si el backend está expuesto directo).
TRUSTED_PROXIES=
# HSTS: activar solo si el borde sirve HTTPS.
HSTS_ENABLED=true
# Swagger UI: vacío = true en debug y false en release.
SWAGGER_ENABLED=

# AI question generation (OpenAI-compatible API)
# Provide the BASE URL (with /v1 if applicable) or the FULL chat completions URL
AI_API_URL=https://opencode.ai/zen/go/v1/chat/completions
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
AI_REQUEST_TIMEOUT=120

# OpenCode Go usage (admin dashboard) — reutiliza AI_API_KEY
OPENCODE_USAGE_URL=https://opencode.ai/zen/go/v1/usage
OPENCODE_USAGE_TIMEOUT=10

# Expo push (entrega a móvil; el token de acceso es opcional)
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=
