# Copia este archivo a `.env` y ajusta los valores:
#   cp .env.example .env
#
# `.env` nunca se commitea (ver .gitignore).
#
# Resumen:
#   - OBLIGATORIAS (la app no arranca sin ellas): JWT_SECRET, DB_PASSWORD
#   - CONDICIONAL: SETUP_TOKEN (obligatoria solo con la DB vacía)
#   - El resto tiene default y puede omitirse.

# ─────────────────────────────────────────────────────────────
# BASE DE DATOS
# ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
# OBLIGATORIA: contraseña de PostgreSQL
DB_PASSWORD=
DB_NAME=dev_test_api
# disable | require | verify-full. En producción usa require o verify-full.
DB_SSL_MODE=disable

# ─────────────────────────────────────────────────────────────
# SESIÓN / JWT
# ─────────────────────────────────────────────────────────────
# OBLIGATORIA: secreto para firmar los JWT. Genera uno con: openssl rand -hex 32
JWT_SECRET=
# Horas de validez del token. Recomendado 8–12 en producción. Default: 24
JWT_EXPIRY_HOURS=24

# ─────────────────────────────────────────────────────────────
# SETUP INICIAL — primer usuario admin
# ─────────────────────────────────────────────────────────────
# Token para crear el primer admin (POST /api/v1/auth/setup).
#   - Con la DB vacía es OBLIGATORIA: sin ella el servidor no arranca.
#   - Con usuarios ya creados puede quedar vacía (setup deshabilitado).
#   - Mínimo 16 caracteres. Genera: openssl rand -hex 32
SETUP_TOKEN=

# ─────────────────────────────────────────────────────────────
# SERVIDOR
# ─────────────────────────────────────────────────────────────
# Puerto HTTP. Default: 8080
PORT=8080
# debug | release. En release se apaga Swagger y baja el nivel de logs SQL.
GIN_MODE=release
# Orígenes permitidos por CORS, separados por coma (allowlist exacta).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─────────────────────────────────────────────────────────────
# HTTP HARDENING
# ─────────────────────────────────────────────────────────────
# Tamaño máximo del body JSON en bytes (1 MiB). El import tiene su propio tope de 8 MiB.
MAX_BODY_BYTES=1048576
# IPs/CIDR del reverse proxy, separadas por coma. Vacío = no confiar en X-Forwarded-For.
TRUSTED_PROXIES=
# Emitir HSTS. Actívalo solo si el borde sirve HTTPS.
HSTS_ENABLED=true
# Swagger UI. Vacío = on en debug y off en release.
SWAGGER_ENABLED=

# ─────────────────────────────────────────────────────────────
# RATE LIMIT DE AUTH
# ─────────────────────────────────────────────────────────────
# Peticiones por minuto por IP para /auth/setup y /auth/login. 0 = deshabilitado.
AUTH_RATE_LIMIT_PER_MINUTE=10
# Ráfaga inicial permitida.
AUTH_RATE_LIMIT_BURST=5

# ─────────────────────────────────────────────────────────────
# IA — generación de preguntas (opcional)
# ─────────────────────────────────────────────────────────────
# URL base o completa del endpoint compatible con OpenAI. Sin esto, la generación queda deshabilitada.
AI_API_URL=https://opencode.ai/zen/go/v1/chat/completions
# Clave de la API de IA. Nunca la commitees.
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
# Timeout de la llamada a la IA, en segundos.
AI_REQUEST_TIMEOUT=120

# ─────────────────────────────────────────────────────────────
# OPENCODE GO — consumo en el panel admin (opcional; reutiliza AI_API_KEY)
# ─────────────────────────────────────────────────────────────
OPENCODE_USAGE_URL=https://opencode.ai/zen/go/v1/usage
OPENCODE_USAGE_TIMEOUT=10

# ─────────────────────────────────────────────────────────────
# PUSH — Expo (opcional)
# ─────────────────────────────────────────────────────────────
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# Token de acceso de Expo (opcional; solo si tu proyecto lo exige).
EXPO_ACCESS_TOKEN=
