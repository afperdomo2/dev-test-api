# API backend URL (sin trailing slash)
# Para simulator/emulator usa localhost; para dispositivo real, la IP LAN de tu máquina.
# Ejemplos:
#   EXPO_PUBLIC_API_BASE_URL=http://localhost:8080      (iOS simulator / Android emulator)
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:8080   (dispositivo real en misma red)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# IMPORTANTE — build de APK (EAS cloud):
#   `EXPO_PUBLIC_*` se COMPILA dentro del bundle. EAS cloud NO lee este archivo
#   ni las variables exportadas en tu shell: usa `apps/mobile/eas.json` →
#   build.<perfil>.env.EXPO_PUBLIC_API_BASE_URL.
#   Para cualquier build que no sea de desarrollo debe ser HTTPS (D-41), por
#   ejemplo https://app.tu-dominio.com. Si el backend cambia de URL, hay que
#   volver a compilar el APK.
#   Ver docs/mobile-apk.md.
