# API backend URL (sin trailing slash).
# localhost para simulador/emulador; IP LAN para dispositivo real.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Nombre visible de la app (launcher). Usá "DevTest Pruebas" para pruebas.
EXPO_PUBLIC_APP_NAME=DevTest

# IMPORTANTE — build de APK (EAS cloud):
#   `EXPO_PUBLIC_*` se COMPILA dentro del bundle. EAS cloud NO lee este archivo
#   ni las variables exportadas en tu shell: usa `apps/mobile/eas.json` →
#   build.<perfil>.env.EXPO_PUBLIC_API_BASE_URL.
#   Fuera de desarrollo la URL debe ser HTTPS (D-41). Si cambiás el backend o
#   el nombre, recompilá el APK. Ver docs/mobile-apk.md.
