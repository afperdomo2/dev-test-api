VITE_API_BASE_URL=http://localhost:8080

# Nombre visible de la app (barra superior, sidebar y título de la pestaña).
# Default interno: DevTest. Cambiarlo NO requiere tocar código.
VITE_APP_NAME=DevTest

# Color de identificación del entorno en la barra superior y en el login.
# Valores permitidos (clave, no hex): blue (default), green, amber, red,
# purple, teal, slate. Un valor desconocido cae a blue.
# Convención sugerida:
#   desarrollo  → blue
#   pruebas     → amber
#   producción  → red
VITE_APP_COLOR=blue

# En Docker no se usa este archivo: el contenedor recibe
# VITE_API_BASE_URL="" (same-origin) y VITE_PROXY_TARGET=http://api:8080.
# VITE_APP_NAME y VITE_APP_COLOR se pasan como build args / environment.
# Ver docker/README.md.
