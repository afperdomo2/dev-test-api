# Valores por defecto. En `.env` solo cambiá lo que necesites.
VITE_API_BASE_URL=http://localhost:8080

# Nombre visible de la app (barra, sidebar y título).
VITE_APP_NAME=DevTest

# Color del entorno: blue, green, amber, red, purple, teal, slate.
# Convención: desarrollo=blue, pruebas=amber, producción=red.
VITE_APP_COLOR=blue

# En Docker no se usa este archivo: ver docker/README.md.
