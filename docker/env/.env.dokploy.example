# Variables para pegar en Dokploy → servicio Docker Compose → Environment.
# Este archivo NO se usa como env_file en el compose de Dokploy: Dokploy escribe
# las variables en un .env junto al compose y el YAML las referencia con ${VAR}.
#
# Para pruebas + producción: creá DOS servicios con el mismo
# docker/compose.dokploy.yaml y pegá este set en cada uno. Cambiá al menos
# APP_ORIGIN, DB_NAME, DB_PASSWORD, JWT_SECRET y SETUP_TOKEN. No reutilices
# JWT_SECRET entre entornos (un token de pruebas valdría en producción).
#
# También sirve para validar el compose en local:
#   docker compose -f docker/compose.dokploy.yaml \
#     --env-file docker/env/.env.dokploy.example config -q

# ── Dominio / origen público ────────────────────────────────
# Debe ser el origen exacto que verá el navegador (con https, sin / final).
APP_ORIGIN=https://app.example.com
# Vacío = la SPA llama a /api en el mismo dominio (recomendado). Es un build arg:
# si lo cambiás, Dokploy recompila la imagen en el deploy.
VITE_API_BASE_URL=

# Identidad visual de la instancia. Cada servicio de Dokploy (pruebas/producción)
# debe usar su propio par; se compila en el bundle y exige rebuild.
# Ejemplo pruebas:
#   VITE_APP_NAME=DevTest Pruebas
#   VITE_APP_COLOR=amber
# Presets de color: blue, green, amber, red, purple, teal, slate.
VITE_APP_NAME=DevTest
VITE_APP_COLOR=red

# ── PostgreSQL (servicio `db` del compose) ──────────────────
DB_USER=devtest
DB_PASSWORD=CHANGE_ME_strong_password
DB_NAME=dev_test_api

# ── Backend ─────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRY_HOURS=12
# Primer deploy (DB vacía): obligatorio, mínimo 16 caracteres.
# Crear el admin, luego borrar el valor y redeployar.
SETUP_TOKEN=CHANGE_ME_setup_token_min_16_chars
# Debe cubrir Traefik y la red interna del compose (el peer inmediato del API
# es nginx). Si falta, el rate limit de auth cuenta todo como una sola IP.
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8
GIN_MODE=release
# Dokploy sirve HTTPS vía Traefik: HSTS puede quedar en true.
HSTS_ENABLED=true
SWAGGER_ENABLED=false
# Límites HTTP / rate limit de auth (defaults del backend si se omiten).
MAX_BODY_BYTES=1048576
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_BURST=5
TZ=America/Bogota

# ── IA (opcional) ───────────────────────────────────────────
AI_API_URL=https://opencode.ai/zen/go/v1/chat/completions
AI_API_KEY=
AI_MODEL=deepseek-v4.1-flash
AI_REQUEST_TIMEOUT=120
# Consumo de OpenCode Go en el panel admin (reutiliza AI_API_KEY).
OPENCODE_USAGE_URL=https://opencode.ai/zen/go/v1/usage
OPENCODE_USAGE_TIMEOUT=10

# ── Push Expo (opcional) ────────────────────────────────────
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=
