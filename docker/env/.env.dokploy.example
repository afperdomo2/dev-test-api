# Variables para pegar en Dokploy → servicio Docker Compose → Environment.
# Este archivo NO se usa como env_file en el compose de Dokploy: Dokploy escribe
# las variables en un .env junto al compose y el YAML las referencia con ${VAR}.
#
# Para pruebas + producción: creá DOS servicios con el mismo
# docker/compose.dokploy.yaml y pegá este set en cada uno. Cambiá al menos
# APP_ORIGIN, DB_NAME, DB_PASSWORD, JWT_SECRET y SETUP_TOKEN. No reutilices
# JWT_SECRET entre entornos (un token de pruebas valdría en producción).
#
# Las variables que aparecen VACÍAS son OBLIGATORIAS y propias de cada servicio:
# no tienen default ni en el compose ni en el código, y el deploy falla si
# faltan (es intencional: nunca se arranca con un secreto de ejemplo).
# Generá secretos con: openssl rand -hex 16 ó openssl rand -hex 32
#
# El resto de los valores escritos son los DEFAULTS del compose: si los omitís,
# queda el mismo valor. Están para que se vea qué aplica; cambiarlos es una
# decisión explícita, no un requisito.
#
# También sirve para validar el compose en local (make docker-config inyecta
# dummies para las obligatorias):
#   docker compose -f docker/compose.dokploy.yaml \
#     --env-file docker/env/.env.dokploy.example config -q

# ── Dominio / origen público ────────────────────────────────
# OBLIGATORIA. Origen exacto que verá el navegador (https, sin / final).
# El compose la usa como CORS_ALLOWED_ORIGINS y falla si queda vacía.
APP_ORIGIN=
# Vacío = la SPA llama a /api en el mismo dominio (recomendado). Es un build arg:
# si lo cambiás, Dokploy recompila la imagen en el deploy.
VITE_API_BASE_URL=

# Identidad visual de la instancia. Cada servicio de Dokploy (pruebas/producción)
# debe usar su propio par; se compila en el bundle y exige rebuild.
# Ejemplo pruebas:
#   VITE_APP_NAME=DevTest Pruebas
#   VITE_APP_COLOR=amber
# Presets de color: blue, green, amber, red, purple, teal, slate.
VITE_APP_NAME=DevTest
VITE_APP_COLOR=red

# ── PostgreSQL (servicio `db` del compose) ──────────────────
DB_USER=devtest
# OBLIGATORIA. openssl rand -hex 16
DB_PASSWORD=
DB_NAME=dev_test_api

# ── Backend ─────────────────────────────────────────────────
# OBLIGATORIA. openssl rand -hex 32
JWT_SECRET=
# Default del compose. En producción se recomienda 12.
JWT_EXPIRY_HOURS=12
# OBLIGATORIA en el primer deploy (DB vacía, mínimo 16 caracteres): sin ella el
# API no arranca, a propósito (D-38). Crear el admin, luego vaciarla y redeployar.
SETUP_TOKEN=
# Default del compose. Debe cubrir Traefik y la red interna (el peer inmediato
# del API es nginx). Si falta, el rate limit de auth cuenta todo como una sola IP.
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8
GIN_MODE=release
# Dokploy sirve HTTPS vía Traefik.
HSTS_ENABLED=true
SWAGGER_ENABLED=false
# Límites HTTP / rate limit de auth.
MAX_BODY_BYTES=1048576
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_BURST=5
TZ=America/Bogota

# ── IA (opcional) ───────────────────────────────────────────
# Se habilita solo si AI_API_URL y AI_API_KEY están informadas; si no, la
# generación de preguntas queda deshabilitada. Ejemplo con OpenCode Go
# (el modelo es del proveedor, no un default):
#   AI_API_URL=https://opencode.ai/zen/go/v1/chat/completions
#   AI_MODEL=deepseek-v4.1-flash
AI_API_URL=
# Nunca la commitees ni la pegues en un repo.
AI_API_KEY=
AI_MODEL=
AI_REQUEST_TIMEOUT=120
# Consumo de OpenCode Go en el panel admin (reutiliza AI_API_KEY).
OPENCODE_USAGE_URL=https://opencode.ai/zen/go/v1/usage
OPENCODE_USAGE_TIMEOUT=10

# ── Push Expo (opcional) ────────────────────────────────────
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=
