# Entorno de desarrollo Docker.
# Copiar a docker/.env (gitignorado):
#   cp docker/env/.env.dev.example docker/.env
#
# Los valores de ejemplo son SOLO para desarrollo local. No reutilizar en
# producción. Generar secretos reales con: openssl rand -hex 32

# ── Puertos del host (no chocan con los servicios nativos) ──
WEB_PORT_HOST=3030
API_PORT_HOST=8082
DB_PORT_HOST=5435

# ── PostgreSQL ───────────────────────────────────────────────
DB_USER=devtest
DB_PASSWORD=dev-only-password-change-me
DB_NAME=dev_test_api

# ── Backend ──────────────────────────────────────────────────
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
JWT_EXPIRY_HOURS=24
# Obligatorio con la DB vacía (mínimo 16 caracteres). Tras crear el admin se
# puede vaciar, pero en dev conviene dejarlo para poder recrear el volumen.
SETUP_TOKEN=dev-only-setup-token-0123456789
CORS_ALLOWED_ORIGINS=http://localhost:3030,http://localhost:3000
HSTS_ENABLED=false
# CIDR de Docker (la API confía en el X-Forwarded-For del proxy Vite/nginx).
TRUSTED_PROXIES=172.16.0.0/12
# Zona horaria del contenedor: define las 08:00 del scheduler de notificaciones.
TZ=America/Bogota

# ── IA (opcional) ────────────────────────────────────────────
AI_API_URL=
AI_API_KEY=
AI_MODEL=
AI_REQUEST_TIMEOUT=120

# ── Push Expo (opcional) ─────────────────────────────────────
EXPO_ACCESS_TOKEN=
