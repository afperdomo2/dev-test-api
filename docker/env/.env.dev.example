# Entorno de desarrollo Docker.
# Copiar a docker/.env (gitignorado):
#   cp docker/env/.env.dev.example docker/.env
# O mejor: `make docker-env`, que además genera los secretos.
#
# Las variables que aparecen VACÍAS son OBLIGATORIAS y propias de cada máquina:
# no tienen default ni en el compose ni en el código. `make docker-env` las
# genera con openssl; nunca reutilices estos valores en producción.
#
# El resto de los valores escritos son los DEFAULTS del compose: si los omitís,
# queda el mismo valor.

# ── Puertos del host (no chocan con los servicios nativos) ──
WEB_PORT_HOST=3030
API_PORT_HOST=8082
DB_PORT_HOST=5435

# ── Web (identidad visual) ───────────────────────────────────
# Se compilan en el bundle: cambiarlas exige rebuild.
# Presets de color: blue, green, amber, red, purple, teal, slate.
VITE_APP_NAME=DevTest
VITE_APP_COLOR=blue

# ── PostgreSQL ───────────────────────────────────────────────
DB_USER=devtest
# OBLIGATORIA. openssl rand -hex 16
DB_PASSWORD=
DB_NAME=dev_test_api

# ── Backend ──────────────────────────────────────────────────
# OBLIGATORIA. openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRY_HOURS=24
# OBLIGATORIA con la DB vacía (mínimo 16 caracteres). Tras crear el admin se
# puede vaciar, pero en dev conviene dejarla para poder recrear el volumen.
SETUP_TOKEN=
# Override del default del compose (que es solo :3030): agrega el dev nativo de
# Vite en :3000. El marcador `# override` es obligatorio para docker-config.
CORS_ALLOWED_ORIGINS=http://localhost:3030,http://localhost:3000 # override: dev nativo
# Dev sirve HTTP (Vite no termina TLS).
HSTS_ENABLED=false
# En dev se mantienen logs debug y Swagger.
GIN_MODE=debug
SWAGGER_ENABLED=true
# CIDR del proxy Vite/nginx (X-Forwarded-For).
TRUSTED_PROXIES=172.16.0.0/12
# Límites HTTP / rate limit de auth.
MAX_BODY_BYTES=1048576
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_BURST=5
# Zona horaria del contenedor: define las 08:00 del scheduler de notificaciones.
TZ=America/Bogota

# ── IA (opcional) ────────────────────────────────────────────
# Se habilita solo si AI_API_URL y AI_API_KEY están informadas. Ejemplo con
# OpenCode Go (el modelo es del proveedor, no un default):
#   AI_API_URL=https://opencode.ai/zen/go/v1/chat/completions
#   AI_MODEL=deepseek-v4.1-flash
AI_API_URL=
AI_API_KEY=
AI_MODEL=
AI_REQUEST_TIMEOUT=120
# Consumo de OpenCode Go en el panel admin (reutiliza AI_API_KEY).
OPENCODE_USAGE_URL=https://opencode.ai/zen/go/v1/usage
OPENCODE_USAGE_TIMEOUT=10

# ── Push Expo (opcional) ─────────────────────────────────────
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=
