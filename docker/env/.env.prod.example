# Entorno PROD-LOCAL (ensayo realista en la PC).
# Copiar a docker/.env.prod (gitignorado):
#   cp docker/env/.env.prod.example docker/.env.prod
# O mejor: `make docker-env-prod`, que además genera los secretos.
#
# Ojo: `docker compose -f docker/compose.prod.yaml` sin `--env-file` carga
# docker/.env (el de dev). Usá siempre `make docker-prod` o pasá
# `--env-file docker/.env.prod`.
#
# Las variables que aparecen VACÍAS son OBLIGATORIAS y propias de cada máquina:
# no tienen default ni en el compose ni en el código. El stack falla si faltan
# (es intencional: nunca se arranca con un secreto de ejemplo).
# `make docker-env-prod` las genera con openssl.
#
# El resto de los valores escritos son los DEFAULTS del compose: si los omitís,
# queda el mismo valor.

# ── Puerto del host (único punto de entrada) ─────────────────
WEB_PORT_HOST=8088

# ── Web (identidad visual) ───────────────────────────────────
# En prod-local el rojo recuerda que NO es desarrollo. Se compilan en el
# bundle: cambiarlas exige rebuild.
VITE_APP_NAME=DevTest
VITE_APP_COLOR=red

# ── PostgreSQL ───────────────────────────────────────────────
DB_USER=devtest
# OBLIGATORIA. openssl rand -hex 16
DB_PASSWORD=
DB_NAME=dev_test_api

# ── Backend ──────────────────────────────────────────────────
# OBLIGATORIA. openssl rand -hex 32
JWT_SECRET=
# Default del compose. En producción se recomienda 12.
JWT_EXPIRY_HOURS=12
# OBLIGATORIA en el primer arranque (DB vacía, mínimo 16 caracteres): sin ella
# el API no arranca, a propósito (D-38).
# Después de crear el admin: dejarla vacía y reiniciar.
SETUP_TOKEN=
# Prod-local: :8088.
CORS_ALLOWED_ORIGINS=http://localhost:8088
# Prod-local sirve HTTP; en Dokploy (HTTPS) debe ser true.
HSTS_ENABLED=false
GIN_MODE=release
SWAGGER_ENABLED=false
# CIDR del proxy Docker.
TRUSTED_PROXIES=172.16.0.0/12
# Límites HTTP / rate limit de auth.
MAX_BODY_BYTES=1048576
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_BURST=5
TZ=America/Bogota

# ── IA (opcional) ────────────────────────────────────────────
# Se habilita solo si AI_API_URL y AI_API_KEY están informadas; si no, la
# generación de preguntas queda deshabilitada. Ejemplo con OpenCode Go
# (el modelo es del proveedor, no un default):
#   AI_API_URL=https://opencode.ai/zen/go/v1/chat/completions
#   AI_MODEL=deepseek-v4.1-flash
AI_API_URL=
# Nunca la commitees.
AI_API_KEY=
AI_MODEL=
AI_REQUEST_TIMEOUT=120
# Consumo de OpenCode Go en el panel admin (reutiliza AI_API_KEY).
OPENCODE_USAGE_URL=https://opencode.ai/zen/go/v1/usage
OPENCODE_USAGE_TIMEOUT=10

# ── Push Expo (opcional) ─────────────────────────────────────
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=
