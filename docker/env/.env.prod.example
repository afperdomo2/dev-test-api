# Entorno PROD-LOCAL (ensayo realista en la PC).
# Copiar a docker/.env (gitignorado):
#   cp docker/env/.env.prod.example docker/.env
#
# Cambiar TODOS los valores CHANGE_ME. Generar secretos con:
#   openssl rand -hex 32

# ── Puerto del host (único punto de entrada) ─────────────────
WEB_PORT_HOST=8088

# ── PostgreSQL ───────────────────────────────────────────────
DB_USER=devtest
DB_PASSWORD=CHANGE_ME_postgres_password
DB_NAME=dev_test_api

# ── Backend ──────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRY_HOURS=12
# Obligatorio en el primer arranque (DB vacía, mínimo 16 caracteres).
# Después de crear el admin: dejarlo vacío y reiniciar.
SETUP_TOKEN=CHANGE_ME_setup_token_min_16_chars
CORS_ALLOWED_ORIGINS=http://localhost:8088
# Prod-local sirve HTTP; en Dokploy (HTTPS) debe ser true.
HSTS_ENABLED=false
SWAGGER_ENABLED=false
TRUSTED_PROXIES=172.16.0.0/12
TZ=America/Bogota

# ── IA (opcional) ────────────────────────────────────────────
AI_API_URL=
AI_API_KEY=
AI_MODEL=
AI_REQUEST_TIMEOUT=120

# ── Push Expo (opcional) ─────────────────────────────────────
EXPO_ACCESS_TOKEN=
